rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function estAdmin() {
      return connecte() && request.auth.token.email == 'djamam782@gmail.com';
    }
    function estApprouve() {
      return connecte()
        && exists(/databases/$(database)/documents/acces/$(request.auth.uid))
        && get(/databases/$(database)/documents/acces/$(request.auth.uid)).data.statut == 'approuve';
    }

    // Fiches élèves : lecture pour l'admin et les enseignants approuvés, écriture admin seul
    match /eleves/{id} {
      allow read: if estAdmin() || estApprouve();
      allow write: if estAdmin();
    }

    // Demandes d'accès : chacun crée sa propre demande (en attente), l'admin décide
    match /acces/{uid} {
      allow read: if estAdmin() || (connecte() && request.auth.uid == uid);
      allow create: if connecte() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nom','email','statut','date'])
        && request.resource.data.statut == 'en_attente'
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if estAdmin();
    }
  }
}
